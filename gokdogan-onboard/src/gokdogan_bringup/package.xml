<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gokdogan_bringup</name>
  <version>0.1.0</version>
  <description>GÖKDOĞAN bringup — competition.launch.py + config/{sitl,hardware}.yaml + MAVROS (SAD §5/§20).</description>
  <maintainer email="hasancan9091@gmail.com">GOKDOGAN Team</maintainer>
  <license>Proprietary</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>mavros</exec_depend>
  <exec_depend>mavros_extras</exec_depend>
  <exec_depend>gokdogan_mission_fsm</exec_depend>
  <exec_depend>gokdogan_mavlink_iface</exec_depend>
  <exec_depend>gokdogan_mission_link</exec_depend>
  <exec_depend>gokdogan_target_selector</exec_depend>
  <exec_depend>gokdogan_guidance</exec_depend>
  <exec_depend>gokdogan_hss</exec_depend>
  <exec_depend>gokdogan_kamikaze</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
