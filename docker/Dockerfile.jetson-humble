# syntax=docker/dockerfile:1
# ============================================================================
# GÖKDOĞAN — ÜRETİM imajı (Jetson Xavier NX · L4T · ROS2 Humble + CUDA/TensorRT)
#
#   ⚠️ ON-DEVICE DOĞRULAMA GEREKİR ⚠️
#   Bu imaj x86 dev makinesinde BUILD EDİLEMEZ / TEST EDİLEMEZ (arm64 + CUDA/TRT + Jetson
#   sürücüleri gerektirir). Saha ekibi Jetson üzerinde build + doğrular.
#   Kaynak: SAD §4. Temel imaj jetson-containers (dustynv/ros:humble-*).
#
#   Build (JETSON ÜZERİNDE, x86'da DEĞİL):
#     docker build -f docker/Dockerfile.jetson-humble -t gokdogan-onboard:latest .
#   Çalıştırma: SAD §4 (--runtime nvidia --network host --device ttyTHS1/video0 ...)
# ============================================================================

# L4T tabanlı ROS2 Humble + CUDA + cuDNN + TensorRT (JetPack 5.x / TRT 8.x)
ARG BASE_IMAGE=dustynv/ros:humble-desktop-l4t-r35.4.1
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    ROS_DISTRO=humble \
    ROS_LOCALHOST_ONLY=1 \
    RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

SHELL ["/bin/bash", "-c"]

# ---------------------------------------------------------------------------
# Sistem + ROS köprü paketleri (MAVROS, GStreamer/NVENC, colcon)
#   Not: TensorRT/CUDA/cuDNN taban imajdan gelir. GStreamer nvv4l2h264enc L4T'de mevcut.
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3-pip python3-colcon-common-extensions python3-vcstool \
      ros-humble-mavros ros-humble-mavros-extras ros-humble-mavros-msgs \
      ros-humble-rmw-cyclonedds-cpp \
      libzbar0 \
      gstreamer1.0-tools gstreamer1.0-plugins-base gstreamer1.0-plugins-good \
      gstreamer1.0-plugins-bad gstreamer1.0-rtsp \
    && rm -rf /var/lib/apt/lists/*

RUN /opt/ros/humble/lib/mavros/install_geographiclib_datasets.sh || true

# Python deps (TensorRT runtime taban imajdan; onnxruntime-gpu ⚠️ cihaza özgü tekerlek gerekebilir)
RUN python3 -m pip install msgpack pyzbar pymavlink scipy

# ---------------------------------------------------------------------------
# Onboard workspace — cihazda colcon build (⚠️ ON-DEVICE)
# ---------------------------------------------------------------------------
WORKDIR /opt/gokdogan/ws
COPY gokdogan-onboard/ /opt/gokdogan/ws/
# ⚠️ ON-DEVICE: aşağıdaki build yalnız Jetson'da koşar (arm64 + CUDA).
# RUN source /opt/ros/humble/setup.bash && colcon build --packages-up-to gokdogan_bringup

# TensorRT engine (.plan) CİHAZA ÖZGÜ — Jetson'da trtexec ile ONNX'ten derlenir, /models'a yazılır.
# (build makinesinde DEĞİL — SAD §4)
VOLUME ["/models", "/logs"]

COPY docker/entrypoint.dev.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["ros2", "launch", "gokdogan_bringup", "competition.launch.py", "mode:=hardware"]
