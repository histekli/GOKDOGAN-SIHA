# syntax=docker/dockerfile:1
# ============================================================================
# GÖKDOĞAN — DEV / CI imajı (x86-64)
# ROS2 Humble (desktop) + ArduPilot SITL + MAVROS + colcon + python deps.
# Amaç: SITL-önce geliştirme. Jetson/TensorRT/gerçek donanım YOK (bkz Dockerfile.jetson-humble).
# Gazebo (gz/ros_gz) bilinçli olarak DIŞARIDA: Kabul Kapısı -1 (headless SITL takeoff)
# Gazebo gerektirmez; sanal kamera Faz 3'te eklenir. Bkz PROGRESS.md [K-02].
# ============================================================================
FROM osrf/ros:humble-desktop

ENV DEBIAN_FRONTEND=noninteractive \
    PIP_BREAK_SYSTEM_PACKAGES=1 \
    PIP_NO_CACHE_DIR=1 \
    ROS_DISTRO=humble \
    ROS_LOCALHOST_ONLY=1 \
    RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

SHELL ["/bin/bash", "-c"]

# ---------------------------------------------------------------------------
# 1) Sistem + build araçları + ArduPilot SITL derleme bağımlılıkları
#    (install-prereqs-ubuntu.sh yerine elle: container'da daha güvenilir/tekrarlanabilir)
# ---------------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ccache g++ gawk make wget curl git rsync \
      python3-pip python3-dev python3-setuptools python3-wheel \
      python3-numpy python3-pexpect python3-matplotlib \
      libtool libxml2-dev libxslt1-dev zlib1g-dev \
      libzbar0 net-tools iproute2 gnupg lsb-release ca-certificates \
      python3-colcon-common-extensions python3-vcstool \
      ros-humble-mavros ros-humble-mavros-extras ros-humble-mavros-msgs \
      ros-humble-rmw-cyclonedds-cpp \
    && rm -rf /var/lib/apt/lists/*

# MAVROS geographiclib veri setleri (UTM/geoid — MAVROS uyarı/hatalarını önler)
RUN /opt/ros/humble/lib/mavros/install_geographiclib_datasets.sh || \
    (wget -q https://raw.githubusercontent.com/mavlink/mavros/ros2/mavros/scripts/install_geographiclib_datasets.sh \
        -O /tmp/geo.sh && bash /tmp/geo.sh)

# ---------------------------------------------------------------------------
# 2) Python bağımlılıkları (SAD: mission_link, algı, sim)
#    empy 3.3.4 pinlenir — Humble rosidl/colcon bununla derler (yenisi bozar).
# ---------------------------------------------------------------------------
RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install \
      "empy==3.3.4" \
      msgpack numpy scipy \
      opencv-python-headless pyzbar \
      onnxruntime \
      pymavlink MAVProxy \
      future lxml pexpect \
      pytest pytest-cov flake8 black

# ---------------------------------------------------------------------------
# 3) ArduPilot SITL — kaynak derleme (ArduCopter, Kabul Kapısı -1 aracı)
#    ArduPlane Faz 1'de eklenir (waf + ccache ucuz).
# ---------------------------------------------------------------------------
ARG ARDUPILOT_TAG=Copter-4.5.7
ENV ARDUPILOT_HOME=/opt/ardupilot
RUN git clone --depth 1 --branch ${ARDUPILOT_TAG} --recurse-submodules --shallow-submodules \
      https://github.com/ArduPilot/ardupilot.git ${ARDUPILOT_HOME}

WORKDIR ${ARDUPILOT_HOME}
RUN ./waf configure --board sitl && \
    ./waf copter && \
    ./waf plane && \
    rm -rf ${ARDUPILOT_HOME}/build/sitl/*.o 2>/dev/null || true

# sim_vehicle.py + araç binary'leri PATH'e
ENV PATH="${ARDUPILOT_HOME}/Tools/autotest:${ARDUPILOT_HOME}/build/sitl/bin:${PATH}"

# ---------------------------------------------------------------------------
# 3.5) Test araçları (ArduPilot katmanından SONRA — cache korunur):
#   - pytest 7.x pinlenir: 8.x ROS2 Humble launch_testing eklentisini bozar (hookspec 'path').
#   - jsonschema: mission_link MessagePack şema doğrulaması (contracts/) için.
# ---------------------------------------------------------------------------
RUN python3 -m pip install "pytest==7.4.4" jsonschema \
    "numpy==1.24.4" "scipy==1.10.1"
# numpy/scipy uyumlu pin: pip numpy 2.x, apt scipy'nin numpy.Inf'ını kırıyordu;
# 1.24.4/1.10.1 ROS2 Humble + onnxruntime + opencv ile uyumlu.

# ---------------------------------------------------------------------------
# 4) colcon workspace mount noktası + entrypoint (ROS + ArduPilot ortamı)
# ---------------------------------------------------------------------------
WORKDIR /workspace
COPY docker/entrypoint.dev.sh /usr/local/bin/entrypoint.dev.sh
RUN chmod +x /usr/local/bin/entrypoint.dev.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.dev.sh"]
CMD ["bash"]
