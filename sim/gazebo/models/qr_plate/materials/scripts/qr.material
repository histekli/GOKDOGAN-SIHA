// GÖKDOĞAN QR plaka materyali — qr.png dokusunu düz plakaya uygular (Gazebo Classic Ogre).
material QrPlate/Diffuse
{
  receive_shadows on
  technique
  {
    pass
    {
      ambient 1 1 1 1
      diffuse 1 1 1 1
      specular 0.1 0.1 0.1 1 12.5
      texture_unit
      {
        texture qr.png
        filtering trilinear
      }
    }
  }
}
