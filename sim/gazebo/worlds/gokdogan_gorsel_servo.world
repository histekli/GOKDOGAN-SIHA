<?xml version="1.0" ?>
<!-- GÖKDOĞAN GÖRSEL-SERVO dünyası (headless CI + GUI):
       gokdogan_iris_cam (kameralı copter, ArduCopter `-f gazebo-iris` kenetli)
       + uçan kırmızı rakip (copter kamerasının önünde, +x tarafında tur atar)
       + QR yer-hedefi.
     Uçan araç kamerasından YOLO tespiti → kamera-in-the-loop algı kanıtı.
     Fizik: iris_arducopter_runway ile BİREBİR (kanıtlanmış). -->
<sdf version="1.6">
  <world name="gokdogan_gorsel_servo">

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>37.413534</latitude_deg>
      <longitude_deg>-121.996561</longitude_deg>
      <elevation>1.3</elevation>
    </spherical_coordinates>

    <physics type="ode">
      <ode>
        <solver><type>quick</type><iters>100</iters><sor>1.0</sor></solver>
        <constraints>
          <cfm>0.0</cfm><erp>0.2</erp>
          <contact_max_correcting_vel>0.1</contact_max_correcting_vel>
          <contact_surface_layer>0.0</contact_surface_layer>
        </constraints>
      </ode>
      <real_time_update_rate>400</real_time_update_rate>
      <max_step_size>0.0025</max_step_size>
    </physics>

    <!-- gölgeler kapalı: render yükünü düşürür, algıya etkisi yok -->
    <scene><ambient>0.7 0.7 0.7 1</ambient><background>0.55 0.72 0.95 1</background><sky/><shadows>false</shadows></scene>

    <include><uri>model://sun</uri></include>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>5000 5000</size></plane></geometry>
          <surface><friction><ode><mu>50</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="grass">
          <cast_shadows>false</cast_shadows>
          <geometry><plane><normal>0 0 1</normal><size>5000 5000</size></plane></geometry>
          <material><ambient>0.35 0.5 0.28 1</ambient><diffuse>0.4 0.55 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Kameralı copter (kamera +x yönüne bakar, 20° aşağı) -->
    <include>
      <uri>model://gokdogan_iris_cam</uri>
      <pose>0 0 0.2 0 0 0</pose>
    </include>

    <!-- Rakip: copter'ın önünde (+x), 22m irtifada yatay tur — kamera görüş alanında -->
    <actor name="opponent_1">
      <link name="body">
        <visual name="govde">
          <geometry><box><size>2.2 0.35 0.35</size></box></geometry>
          <material><ambient>0.85 0.05 0.05 1</ambient><diffuse>0.9 0.08 0.08 1</diffuse></material>
        </visual>
        <visual name="kanat">
          <pose>-0.25 0 0 0 0 0</pose>
          <geometry><box><size>0.55 3.2 0.06</size></box></geometry>
          <material><ambient>0.85 0.05 0.05 1</ambient><diffuse>0.9 0.08 0.08 1</diffuse></material>
        </visual>
        <visual name="kuyruk">
          <pose>0.95 0 0.16 0 0 0</pose>
          <geometry><box><size>0.3 1.1 0.05</size></box></geometry>
          <material><ambient>0.85 0.05 0.05 1</ambient><diffuse>0.9 0.08 0.08 1</diffuse></material>
        </visual>
      </link>
      <script>
        <loop>true</loop>
        <auto_start>true</auto_start>
        <trajectory id="0" type="fly">
          <waypoint><time>0</time> <pose>28 -18 14 0 0 1.5708</pose></waypoint>
          <waypoint><time>8</time> <pose>28  18 14 0 0 1.5708</pose></waypoint>
          <waypoint><time>8.2</time><pose>28 18 14 0 0 -1.5708</pose></waypoint>
          <waypoint><time>16</time><pose>28 -18 14 0 0 -1.5708</pose></waypoint>
          <waypoint><time>16.2</time><pose>28 -18 14 0 0 1.5708</pose></waypoint>
        </trajectory>
      </script>
    </actor>

    <!-- Kamikaze QR hedefi -->
    <include>
      <uri>model://qr_ground_target</uri>
      <pose>40 15 0.2 0 0 0</pose>
    </include>

  </world>
</sdf>
